import pandas as pd
import numpy as np
import hashlib

from google.colab import files

uploaded = files.upload()

file_name = "USECASE - Data Engineering.xlsx"

product = pd.read_excel(file_name, sheet_name="product_details")
retail1 = pd.read_excel(file_name, sheet_name="retail_data1")
retail2 = pd.read_excel(file_name, sheet_name="retail_data2")

retail = pd.concat([retail1, retail2], ignore_index=True)

print(retail.shape)

print("Before:", retail.shape)

retail.drop_duplicates(inplace=True)

print("After:", retail.shape)

retail = retail.merge(
    product,
    on="product_id",
    how="left",
    suffixes=("", "_master")
)

retail["price"] = retail["price"].fillna(
    retail["price_master"]
)

retail.drop(
    columns=["price_master"],
    inplace=True
)

retail.isnull().sum()

for col in retail.columns:

    if retail[col].dtype == "object":
        retail[col] = retail[col].fillna("Unknown")

    else:
        retail[col] = retail[col].fillna(
            retail[col].median()
        )

retail["product_name"] = (
    retail["product_name"]
    .astype(str)
    .str.strip()
    .str.title()
)

retail["category"] = retail["category"].replace({
    "ELEC": "Electronics",
    "electronics": "Electronics"
})

retail["purchase_location"] = (
    retail["purchase_location"]
    .astype(str)
    .str.lower()
    .str.strip()
)

retail["transaction_date"] = pd.to_datetime(
    retail["transaction_date"],
    errors="coerce"
)

retail = retail[
    retail["quantity"] > 0
]

retail["email"] = retail["email"].astype(str).apply(
    lambda x: hashlib.sha256(
        x.encode()
    ).hexdigest()
)

retail["phone"] = retail["phone"].astype(str).apply(
    lambda x: "XXXXXX" + x[-4:]
)

retail["revenue"] = (
    retail["price"] *
    retail["quantity"]
)

retail["discount_amount"] = (
    retail["revenue"] *
    retail["discount"]
)

retail["net_revenue"] = (
    retail["revenue"] -
    retail["discount_amount"]
)

print("Total Revenue =", retail["net_revenue"].sum())

category_rev = retail.groupby(
    "category"
)["net_revenue"].sum().reset_index()

category_rev

city_rev = retail.groupby(
    "city"
)["net_revenue"].sum().reset_index()

city_rev

top_products = retail.groupby(
    "product_name"
)["quantity"].sum().sort_values(
    ascending=False
)

top_products.head(10)

retail.to_csv(
    "Cleaned_Retail_Data.csv",
    index=False
)

print("Saved Successfully")

